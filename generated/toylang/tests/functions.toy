// Canonical: functions — definition, call, return value, recursion.
func add(a, b) {
    return a + b;
}

func factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

print(add(3, 4));       // 7
print(factorial(5));    // 120
print(factorial(0));    // 1
print(factorial(10));   // 3628800
