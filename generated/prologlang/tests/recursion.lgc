% Canonical: recursion. Factorial as a recursive predicate. Base case
% factorial(0, 1); recursive case multiplies n by factorial(n-1).
factorial(0, 1).
factorial(N, F) :-
    N > 0,
    N1 is N - 1,
    factorial(N1, F1),
    F is N * F1.

:- factorial(0, F), write(F), nl.
:- factorial(1, F), write(F), nl.
:- factorial(5, F), write(F), nl.
:- factorial(7, F), write(F), nl.
