# Python build / bytecode artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Local virtualenvs
.venv/
venv/
env/

# Environment files
.env
.env.*
*.env

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Node (REPL embedding tooling occasionally pulls these in)
node_modules/

# Agent / harness local state (not part of the project)
.agent-state/
upload/
uploads/

# Forge generated languages. The hand-written reference compilers
# (toylang, lisplang, forthlang) and the stacky test fixture are
# tracked because they're templated from by the generator and the test
# suite depends on them. Everything else under generated/ is throwaway
# LLM output.
generated/*
!generated/toylang/
!generated/lisplang/
!generated/forthlang/
!generated/stacky/
!generated/mllang/
!generated/prologlang/

# Per-language artifacts that ARE generated (logs, compiled outputs,
# bytecode caches, kata caches) shouldn't be tracked even for the
# reference compilers.
generated/*/.forge_log/
generated/*/__pycache__/
generated/*/tests/*.out.py
generated/*/_playground/*.out.py
generated/*/examples/*.out.py
# Kata pack caches (regenerated from curated source on demand).
generated/*/katas.json
# Per-generation telemetry (Phase 0.4); cache-like, not source.
generated/*/generation_summary.json
generated/*/generation_events.jsonl

# Batch output directories. Each batch (Phase 1.5 gates, ml family
# experiment, structural variance work, Phase 4 pre-flight, logic
# family experiment, etc.) writes generated languages under a
# `catalog_raw_*` or `catalog_*` directory. These are throwaway
# artifacts — the curated DB is what persists. Without this pattern
# the harness auto-commit silently captures hundreds of files per
# batch.
catalog_raw_*/
catalog_logic_*/
catalog_phase4_*/
catalog_ml_*/
catalog_structural_*/
catalog_svc_*/
catalog_variance_*/

# Catalog SQLite DBs are local artifacts; the corpus is rebuildable
# from the slot plan + a fresh batch. Keep the GUI's pointer
# (`catalog.db`) tracked when needed but block all `catalog_*.db`
# and `.db.<suffix>` backups.
catalog_*.db
catalog_*.db.*
catalog.db.*
*.phase4_backup.db

# Forge resolver cache (Phase 0.3). Auto-invalidates on
# RESOLVER_PROMPT_VERSION / RESOLVER_SCHEMA_VERSION bumps. Kilobytes
# per entry — easy to balloon in batch runs.
.forge_cache/

# Phase 1 batch output staging. The catalog directory is the eventual
# committed artifact; staging is throwaway.
catalog_staging/
catalog_raw/
catalog_raw_*/
batch_output/

# Phase 2 catalog DB and per-batch curation reports. The DB is
# generated by `python -m forge.catalog.curate`; the .curation/
# directory holds the per-batch JSON reports it writes for audit.
catalog.db
catalog*.db
catalog*.db-journal
*/.curation/

# Conversation-derived reports + ad-hoc instruction docs. Kept locally
# for reference but not committed to the public repo.
# Catch-all patterns first so future findings docs are auto-ignored.
*-instructions.md
*instructions*.md
*-findings.md
*findings*.md
*-followup.md
*-design*.md
*-experiment*.md
*_REPORT.md
*_REVIEW.md
*_FINDINGS.md
*_AUDIT.md
*_DIAGNOSIS.md
*_NOTES.md
*_OVERVIEW.md
*_DESIGN.md
*_CLOSEOUT.md
PROJECT_REPORT.md
PROJECT_OVERVIEW.md
PHASE*.md
phase*.md
variance-*.md
verification_*/
catalog.db.backup*
catalog.db.preserved
catalog.db.pre_*

# Background-task log files written by the harness when batch
# commands run via run_in_background. Per-run noise, not source.
.batch_*.txt
.batch_*.log
.gui_log.txt

# Raw LLM prompt + response logs (forge writes these per-call under
# .forge_log/ inside generated lang dirs; never commit them).
**/.forge_log/

# Specific historical files (kept for clarity; the patterns above
# also cover them).
API_COST_AUDIT.md
CODEBASE_REVIEW.md
PIPELINE_DIAGNOSIS.md
PHASE15_BUGFIX_GATE2_FINDINGS.md
PHASE15_BUGFIX_REPORT.md
PHASE15_CHANGE_REVIEW.md
PHASE15_CLOSEOUT_REPORT.md
PHASE15_FINAL_REPORT.md
PHASE15_GATE2_FINDINGS.md
PHASE2_REPORT.md
PHASE3_REPORT.md
PHASE3_REVIEW.md
PHASE3_VALIDATION_NOTES.md
PHASE3_FOLLOWUP_REVIEW.md
PHASE3_FOLLOWUP_FINDINGS.md
