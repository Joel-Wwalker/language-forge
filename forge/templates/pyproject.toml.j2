[project]
name = "{{ lang_name }}"
version = "0.1.0"
description = "{{ lang_name }}, a {{ syntax }} programming language with {{ typing }} typing and {{ memory }} memory. Generated by Language Forge."
readme = "README.md"
license = {text = "MIT"}
requires-python = ">=3.11"
dependencies = [
    "lark>=1.1.9",
]
authors = [
    {name = "Generated by Language Forge"},
]
keywords = ["programming-language", "compiler", "transpiler", "{{ syntax }}", "{{ typing }}"]

[project.scripts]
{{ lang_name }} = "{{ lang_name }}.compile:main"

[project.urls]
Source = "https://example.com/{{ lang_name }}"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools]
# The package files live at the project root (this directory IS the package),
# so we point setuptools at "." for the package "{{ lang_name }}".
packages = ["{{ lang_name }}"]
package-dir = {"{{ lang_name }}" = "."}
include-package-data = true

[tool.setuptools.package-data]
"{{ lang_name }}" = ["examples/*", "tests/*"]
