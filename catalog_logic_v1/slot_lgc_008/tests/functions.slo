% Canonical: functions. Prolog has predicates, not functions, but the
% last-argument-is-output convention makes them function-like. Define
% double/2 (input, result) and apply it.
double(X, Y) :- Y is X * 2.
square(X, Y) :- Y is X * X.

:- double(5, R), write(R), nl.
:- double(7, R), write(R), nl.
:- square(4, R), write(R), nl.
:- double(3, A), square(A, B), write(B), nl.
